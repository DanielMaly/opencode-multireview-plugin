{
  "name": "opencode-multireview-plugin",
  "version": "1.0.0-0",
  "description": "OpenCode plugin bundling MMAR review agents and history tools.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "opencode-multireview": "dist/cli.js"
  },
  "files": [
    "dist/",
    "assets/agents/",
    "assets/migrations/",
    "assets/skills/",
    "config/",
    "scripts/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run build",
    "test": "node --test test/*.test.js",
    "release": "release-it",
    "release:dry-run": "release-it --dry-run",
    "prepack": "npm run build",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.20"
  },
  "keywords": [
    "opencode",
    "plugin",
    "code-review",
    "review-findings"
  ],
  "license": "MIT",
  "author": "Daniel Maly",
  "repository": {
    "type": "git",
    "url": "https://github.com/DanielMaly/opencode-multireview-plugin.git"
  },
  "homepage": "https://github.com/DanielMaly/opencode-multireview-plugin#readme",
  "bugs": {
    "url": "https://github.com/DanielMaly/opencode-multireview-plugin/issues"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "auto-changelog": "^2.5.0",
    "release-it": "^19.0.4",
    "typescript": "^5.9.3"
  },
  "release-it": {
    "git": {
      "changelog": "npx auto-changelog --stdout --commit-limit false --unreleased --template https://raw.githubusercontent.com/release-it/release-it/main/templates/changelog-compact.hbs",
      "commitMessage": "Release v${version}",
      "tagName": "v${version}",
      "requireCleanWorkingDir": true,
      "requireUpstream": true,
      "commit": true,
      "tag": true,
      "push": true
    },
    "npm": {
      "publish": false
    },
    "hooks": {
      "before:init": [
        "npm test"
      ],
      "after:bump": "npx auto-changelog --commit-limit false --template https://raw.githubusercontent.com/release-it/release-it/main/templates/keepachangelog.hbs"
    }
  }
}
